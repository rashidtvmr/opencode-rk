# Build artifacts
/target/

# Full upstream checkouts (detached, own .git dirs) - regenerated by tools/freeze_sources.py
/.upstream/

# Python bytecode
__pycache__/
*.pyc

# repowise local state (caches, lancetdb, wiki, jobs) - machine-local, never commit
.repowise/

# Agent tooling config - local, machine-specific
.claude/
.codex/
.mcp.json

# repowise API keys (local)
.repowise/.env

# Autonomous controller state and lane worktrees - machine-local
/state/
/.worktrees/
