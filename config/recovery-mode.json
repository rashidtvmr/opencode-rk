  "bootstrapMutable": false,
  "requireCanonicalRecoveryConfig": true,
  "rejectUnexpectedLocalBranches": true,
  "rejectUnexpectedWorktrees": true,
  "executionLanes": [
    "recovery/core",
    "recovery/runtime",
    "recovery/ui",
    "recovery/platform"
