  "parallelReadOnlySubagents": 32,
  "parallelImplementationCandidates": 8,
  "parallelIndependentReviewers": 8,
  "subagentPolicy": {
    "allowed": true,
    "readOnlyResearchAndReview": "encouraged",
    "persistentBranchCreation": "forbidden",
    "persistentWorktreeCreation": "forbidden",
    "implementationOutput": "patch_or_candidate_commit_to_lane_owner",
    "reviewOutput": "verdict_and_evidence_only"
  },
  "queuePolicy": {
    "authority": "observed_product_failure_or_unproven_phase1_gate",
    "allowedSources": [
      "compiler",
      "focused-test",
      "phase1-golden-journey",
      "upstream-parity",
      "security-adversarial",
      "unproven-gate"
    ],
    "candidateHighWaterBehavior": "stop_new_implementation_and_shift_to_review_integration_salvage",
    "failedPreparedCandidate": "eject_and_reopen_failure",
    "createRepairDescendantBranch": false,
    "stateMutationsMustUseTool": true,
    "trackedSeedsAreImmutable": true,
    "runtimeStateOutsideTrackedHistory": true,
    "judgeResultsMustBeIngested": true,
    "manualQueueInsertionAllowed": false
  },
  "acceptancePolicy": {
    "exactIntegratedShaRequired": true,
    "workerSelfReportIsAcceptance": false,
    "candidateGreenIsAcceptance": false,
    "claimsCompletedIsAcceptance": false,
    "branchMergedIsAcceptance": false,
    "phase1FailureCountMustBeZero": true,
    "artifactSourceShaMustEqualCurrentMainV2": true,
    "allPhase1GatesMustPassOnSameSha": true,
    "quickJudgeCannotAcceptRelease": true,
    "trackedStateCommitMayNotCreateAcceptance": true
  },
  "resourcePolicy": {
    "cargoBuildJobs": 2,
    "rustTestThreads": 2,
    "preferFocusedBeforeWorkspace": true,
    "centralizeHeavyValidation": true,
    "heavyValidationLock": "git-common-dir/recovery-state/heavy-validation.lock"
  },
  "bootstrapMutable": false,
  "requireCanonicalRecoveryConfig": true,
  "rejectUnexpectedLocalBranches": true,
  "rejectUnexpectedWorktrees": true,
  "executionLanes": [
    "recovery/core",
    "recovery/runtime",
    "recovery/ui",
    "recovery/platform"
  ],
  "approvedRecoveryWorktrees": {
    "main-v2": "/Users/mymac/Projects/opencode-rk-recovery-20261005",
    "recovery/core": "/Users/mymac/Projects/opencode-rk-recovery-lanes/core",
    "recovery/runtime": "/Users/mymac/Projects/opencode-rk-recovery-lanes/runtime",
    "recovery/ui": "/Users/mymac/Projects/opencode-rk-recovery-lanes/ui",
    "recovery/platform": "/Users/mymac/Projects/opencode-rk-recovery-lanes/platform"
  },
  "lanePolicy": {
    "oneActiveFailurePerLane": true,
    "claimRequiresLaneAtCurrentMainV2": true,
    "maxAheadCommits": 6,
    "resetOrFastForwardLaneAfterDisposition": true,
    "rebaseOrReapplyBeforeIntegration": true,
    "overlappingPathGrantsForbidden": true,
    "candidateDiffMustFitPathGrant": true,
    "pathGrantMustFitLaneIntent": true,
    "integrationMode": "fast-forward-only"
  },
  "integrationLock": ".git/recovery-integration.lock",
  "stateLock": ".git/recovery-state.lock",
  "stateMutationTool": "tools/recovery_state.py",
  "evaluationPolicy": {
    "method": "evaluator-optimizer",
    "authorAndReviewerMustBeIndependent": true,
    "blindDiffFirstReview": true,
    "requiredApprovalsByPriority": {
      "P0": 2,
      "P1": 2,
      "P2": 1,
      "P3": 1
    },
    "reviewDisagreement": "any_negative_verdict_requires_new_candidate; third evaluator may diagnose but cannot override a rejection",
    "securityOrPermissionChangeRequiresSecurityEvaluator": true,
    "optimizerMayNotMarkOwnCandidateAccepted": true,
    "protectedEvaluatorPaths": [
      "config/recovery-mode.json",
      "docs/PHASE1_ACCEPTANCE.md",
      "recovery/failures.json",
      "recovery/phase1-gates.json",
      "tools/phase1_judge.py",
      "tools/recovery_guard.py",
      "tools/recovery_state.py",
      "tools/recovery_ref_hook.py",
      "tests/e2e/native_provider_setup.py",
      "tests/e2e/native_stream_tool.py",
      "tests/e2e/native_utf8_input.py",
      "tests/e2e/native_escape_input.py",
      "tests/e2e/native_resize.py",
      "tests/e2e/native_bracketed_paste.py",
      "tests/e2e/native_interactive_pty.py",
      "tests/bootstrap/test_native_provider_auth_control.py"
    ],
    "securitySensitivePaths": [
      "crates/security",
      "crates/tools",
      "crates/server/src/lib.rs",
      "crates/server/src/daemon.rs",
      "crates/providers",
      "crates/cli/src/daemon_client.rs",
      "crates/cli/src/app_start.rs"
    ],
    "evaluatorSensitivePaths": [
      "tools/convergence_gate.py",
      "tests/e2e/native_second_client.py"
    ],
    "evaluatorChangeRequiresTestEvaluator": true,
    "evaluatorChangeMinimumApprovals": 2
  },
  "activationPolicy": {
    "oldControllersAndMergeWavesMustBeStopped": true,
    "canonicalMustContainRecoveryModeBeforeProductClaims": true,
    "fixedLaneBranchesMustStartAtCanonical": true,
    "unexpectedBranchOrWorktreeCreationBlocks": true,
    "installReferenceTransactionHook": true,
    "freezeEvaluatorAtActivation": true,
    "runtimeStateRevisionMustBeAtomic": true
  },
  "salvagePolicy": {
    "legacyInventoryImportAllowed": false,
    "historicalEvidenceOnly": [
      "docs/convergence-v2-salvage.json",
      "docs/CONVERGENCE_V2_SALVAGE.md"
    ],
    "requiresActiveFailure": true,
    "scanEntireFrozenSnapshot": true,
    "collapseAliasesByTipSha": true,
    "maxMaterializedCandidatesPerFailure": 8,
    "oneActiveQueryPerFailure": true,
    "unresolvedCandidatesBlockIntegration": true,
    "terminalDispositions": [
      "ALREADY_PRESENT",
      "SALVAGED_PRODUCT",
      "SALVAGED_TEST",
      "SUPERSEDED_BY",
      "DUPLICATE",
      "PROCESS_ONLY",
      "EVIDENCE_ONLY",
      "CONFLICTING_IMPL_PRESERVED"
    ]
  },
  "optimizerPolicy": {
    "maxFailedCandidateCyclesBeforeStrategyReview": 3,
    "strategyReviewRequiresIndependentEvaluator": true,
    "strategyReviewMustRecordDiagnosisAndNewApproach": true
  }
}
