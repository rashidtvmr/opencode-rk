{
  "schemaVersion": 1,
  "executionMode": "convergence-v2-product-gates",
  "targetWorkers": 0,
  "maxWorkers": 20,
  "maxUnverifiedCandidates": 4,
  "maxHeavyValidations": 1,
  "maxAttemptsPerTask": 2,
  "refillPolicy": "on-observed-independent-failure",
  "acceptancePolicy": "exact-integrated-gate-green",
  "ownershipPolicy": "coherent-slice-explicit-path-set",
  "hostBudgetMiB": 8192,
  "reservedMemoryMiB": 2048,
  "stopAdmittingBelowAvailableMiB": 1024,
  "cargoBuildJobs": 2,
  "rustTestThreads": 2,
  "leaseTtlSeconds": 180,
  "heartbeatSeconds": 30,
  "providerBudgetSource": "config/controller.settings.json",
  "allowBudgetIncrease": false,
  "respectHarnessConcurrencyLimit": true,
  "legacyAutomaticAcceptanceApproved": false,
  "note": "V1 compatibility config only. V2 is failure-driven: do not fill worker slots, do not use one-file task decomposition, stop candidate production at high-water 4, and only exact integrated gate GREEN is acceptance. See config/convergence-v2.json.",
  "schedulingMode": "failure-driven-convergence",
  "minimumUsefulWorkersWhenSupported": 0,
  "reservedIntegrationWorkers": 1,
  "reservedIndependentTestVerifierWorkers": 4,
  "maxBreadthWorkersBeforeLocalE2eGreen": 0,
  "requireConvergenceGateBeforeParentCompletion": true,
  "claimsCompletedIsAcceptance": false,
  "requireIntegratedParentJourney": true
}
