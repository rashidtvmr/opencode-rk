{
  "schemaVersion": 1,
  "executionMode": "recovery-mode-phase1-failure-burndown",
  "targetWorkers": 30,
  "maxWorkers": 48,
  "maxUnverifiedCandidates": 48,
  "maxHeavyValidations": 3,
  "maxAttemptsPerTask": 5,
  "refillPolicy": "continuous-unbounded-refill",
  "acceptancePolicy": "exact-integrated-gate-green",
  "ownershipPolicy": "coherent-slice-explicit-path-set",
  "hostBudgetMiB": 24576,
  "reservedMemoryMiB": 4096,
  "stopAdmittingBelowAvailableMiB": 512,
  "cargoBuildJobs": 3,
  "rustTestThreads": 4,
  "leaseTtlSeconds": 900,
  "heartbeatSeconds": 30,
  "providerBudgetSource": "config/controller.settings.json",
  "allowBudgetIncrease": false,
  "respectHarnessConcurrencyLimit": true,
  "legacyAutomaticAcceptanceApproved": false,
  "note": "Recovery Mode is active. Schedule only unresolved items from recovery/failures.json or executable probes for UNPROVEN Phase-1 gates. Legacy branches/worktrees, ralph.json and claims are evidence only. Parallelism ceilings are set to the measured host capacity; they are not coordination caps. Persistent subagent branch/worktree creation stays forbidden: lanes are queue states, not Git topology.",
  "schedulingMode": "phase1-observed-failure-burndown",
  "minimumUsefulWorkersWhenSupported": 30,
  "reservedIntegrationWorkers": 4,
  "reservedIndependentTestVerifierWorkers": 8,
  "maxBreadthWorkersBeforeLocalE2eGreen": 24,
  "requireConvergenceGateBeforeParentCompletion": true,
  "claimsCompletedIsAcceptance": false,
  "requireIntegratedParentJourney": true,
  "recoveryModeConfig": "config/recovery-mode.json",
  "recoveryFailureQueue": "git-common-dir/recovery-state/failures.json",
  "recoveryStateMutationTool": "tools/recovery_state.py",
  "legacyBranchInventorySchedulingAllowed": false,
  "persistentSubagentBranchCreationAllowed": false,
  "persistentSubagentWorktreeCreationAllowed": false
}
