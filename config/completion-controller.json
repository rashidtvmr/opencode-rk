{
  "schemaVersion": 1,
  "executionMode": "main-agent-native-delegation",
  "targetWorkers": 20,
  "maxWorkers": 20,
  "maxUnverifiedCandidates": 20,
  "maxHeavyValidations": 1,
  "maxAttemptsPerTask": 3,
  "refillPolicy": "on-each-worker-completion",
  "acceptancePolicy": "independent-green-and-post-integration-rerun",
  "ownershipPolicy": "one-file-child-lanes-with-parent-path-locks",
  "hostBudgetMiB": 8192,
  "reservedMemoryMiB": 2048,
  "stopAdmittingBelowAvailableMiB": 1024,
  "cargoBuildJobs": 2,
  "rustTestThreads": 2,
  "leaseTtlSeconds": 180,
  "heartbeatSeconds": 30,
  "providerBudgetSource": "config/controller.settings.json",
  "allowBudgetIncrease": false,
  "respectHarnessConcurrencyLimit": true,
  "legacyAutomaticAcceptanceApproved": false,
  "note": "Target 20 native workers, useful minimum 15 when the harness/provider/resource budget supports it. Preserve at least 4 integration-spine and 2 independent test/verifier lanes before breadth. claims.json completion is coordination only; parent acceptance requires independent verification, successful integration, post-integration GREEN, and convergence gate.",
  "schedulingMode": "convergence-first",
  "minimumUsefulWorkersWhenSupported": 15,
  "reservedIntegrationWorkers": 4,
  "reservedIndependentTestVerifierWorkers": 2,
  "maxBreadthWorkersBeforeLocalE2eGreen": 14,
  "requireConvergenceGateBeforeParentCompletion": true,
  "claimsCompletedIsAcceptance": false,
  "requireIntegratedParentJourney": true
}
