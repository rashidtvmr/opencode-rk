{
  "schemaVersion": 1,
  "executionMode": "main-agent-native-delegation",
  "targetWorkers": 20,
  "maxWorkers": 20,
  "maxUnverifiedCandidates": 20,
  "maxHeavyValidations": 1,
  "maxAttemptsPerTask": 3,
  "refillPolicy": "on-each-worker-completion",
  "acceptancePolicy": "independent-green-and-post-integration-rerun",
  "ownershipPolicy": "one-file-child-lanes-with-parent-path-locks",
  "hostBudgetMiB": 8192,
  "reservedMemoryMiB": 2048,
  "stopAdmittingBelowAvailableMiB": 1024,
  "cargoBuildJobs": 2,
  "rustTestThreads": 2,
  "leaseTtlSeconds": 180,
  "heartbeatSeconds": 30,
  "providerBudgetSource": "config/controller.settings.json",
  "allowBudgetIncrease": false,
  "respectHarnessConcurrencyLimit": true,
  "legacyAutomaticAcceptanceApproved": false,
  "note": "Targets are not proof of running workers. Use actual harness-native APIs and complete COORD adapter/lease/sandbox tasks. Never emulate unavailable native delegation with twenty heavy CLI processes or bypass provider limits."
}
