{
  "schemaVersion": 1,
  "executionMode": "recovery-mode-phase1-failure-burndown",
  "targetWorkers": 0,
  "maxWorkers": 20,
  "maxUnverifiedCandidates": 4,
  "maxHeavyValidations": 1,
  "maxAttemptsPerTask": 2,
  "refillPolicy": "recovery-failures-json-only",
  "acceptancePolicy": "exact-integrated-gate-green",
  "ownershipPolicy": "coherent-slice-explicit-path-set",
  "hostBudgetMiB": 8192,
  "reservedMemoryMiB": 2048,
  "stopAdmittingBelowAvailableMiB": 1024,
  "cargoBuildJobs": 2,
  "rustTestThreads": 2,
  "leaseTtlSeconds": 180,
  "heartbeatSeconds": 30,
  "providerBudgetSource": "config/controller.settings.json",
  "allowBudgetIncrease": false,
  "respectHarnessConcurrencyLimit": true,
  "legacyAutomaticAcceptanceApproved": false,
  "note": "Recovery Mode is active. Schedule only unresolved items from recovery/failures.json or executable probes for UNPROVEN Phase-1 gates. Legacy branches/worktrees, ralph.json and claims are evidence only. Subagents may research/review in parallel but may not create persistent branch families. See config/recovery-mode.json and docs/RECOVERY_MODE.md.",
  "schedulingMode": "phase1-observed-failure-burndown",
  "minimumUsefulWorkersWhenSupported": 0,
  "reservedIntegrationWorkers": 1,
  "reservedIndependentTestVerifierWorkers": 4,
  "maxBreadthWorkersBeforeLocalE2eGreen": 0,
  "requireConvergenceGateBeforeParentCompletion": true,
  "claimsCompletedIsAcceptance": false,
  "requireIntegratedParentJourney": true,
  "recoveryModeConfig": "config/recovery-mode.json",
  "recoveryFailureQueue": "git-common-dir/recovery-state/failures.json",
  "recoveryStateMutationTool": "tools/recovery_state.py",
  "legacyBranchInventorySchedulingAllowed": false,
  "persistentSubagentBranchCreationAllowed": false,
  "persistentSubagentWorktreeCreationAllowed": false
}
